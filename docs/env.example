# Copy to .env.local for development and set the same keys in Vercel.

# Launch mode: waitlist before launch, live after.
NEXT_PUBLIC_LAUNCH_STATE=waitlist
NEXT_PUBLIC_SITE_URL=https://furkin.app

# Supabase: the app's project (EU, Frankfurt). The service role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Waitlist email
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Furkin <hello@furkin.app>

# Universal links and App Links
APPLE_TEAM_ID=
IOS_BUNDLE_ID=dev.pixelwitch.furkin
ANDROID_PACKAGE_NAME=dev.pixelwitch.furkin
ANDROID_SHA256_FINGERPRINTS=   # comma separated: upload key and Play app signing key

# After launch
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=dev.pixelwitch.furkin

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=furkin.app
